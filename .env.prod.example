# Production environment file — copy to .env.prod on your Oracle Cloud VM
# Run with: ./deploy.sh  (or: docker compose --env-file .env.prod up -d --build)

NODE_ENV=production

# Host port bound on 127.0.0.1 (keep different from nextjs-prod on 3000)
APP_PORT=3001

# Public URL of this booking app (used for logout redirect)
NEXTAUTH_URL=https://salonapp.my

# Application Mode: "external" (public booking) or "internal" (in-house desk)
NEXT_PUBLIC_APP_MODE=external

# Shared PostgreSQL container (postgres-db from florist-white-label-frontend)
# Use the POSTGRES_USER & POSTGRES_PASSWORD from ~/florist-white-label-frontend/.env.prod
# and database name "salon_db" created in Adminer.
# Prisma requires both DATABASE_URL and DIRECT_URL:
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres-db:5432/salon_db
DIRECT_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres-db:5432/salon_db

# JWT secret — generate with: openssl rand -hex 64
JWT_SECRET=change-this-to-a-64-byte-hex-secret

# Initial admin seeder password (used when running ./deploy.sh --seed)
ADMIN_SEED_PASSWORD=change-this-admin-password

# Public business configuration (baked into client bundle during docker compose build)
NEXT_PUBLIC_BUSINESS_NAME=Serenity Wellness Studio
NEXT_PUBLIC_MERCHANT_WHATSAPP=60123456789
NEXT_PUBLIC_PAYMENT_QR_URL=
NEXT_PUBLIC_BOOKING_REF_PREFIX=BK
NEXT_PUBLIC_OPERATING_HOUR_START=9
NEXT_PUBLIC_OPERATING_HOUR_END=19
NEXT_PUBLIC_CLOSED_DAYS=0
NEXT_PUBLIC_OPERATING_DAYS_DESCRIPTION=Mon – Sat
NEXT_PUBLIC_OPERATING_HOURS_DISPLAY=9:00 AM – 7:00 PM
NEXT_PUBLIC_CURRENCY_SYMBOL=RM
NEXT_PUBLIC_CURRENCY_CODE=MYR
NEXT_PUBLIC_BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
