// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Service & Product catalog
// ---------------------------------------------------------------------------
model Service {
  id              String    @id @default(cuid())
  name            String
  description     String?
  category        String?
  type            String    @default("SERVICE") // "SERVICE" | "PRODUCT"
  durationMinutes Int
  priceCents      Int
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  bookings        Booking[]
  bookingItems    BookingItem[]

  @@map("services")
}

// ---------------------------------------------------------------------------
// Business operating hours (one row per day-of-week, 0 = Sunday … 6 = Saturday)
// ---------------------------------------------------------------------------
model BusinessSchedule {
  id        String  @id @default(cuid())
  dayOfWeek Int     @unique // 0-6
  openTime  String  // "HH:mm" e.g. "09:00"
  closeTime String  // "HH:mm" e.g. "18:00"
  isClosed  Boolean @default(false)

  @@map("business_schedules")
}

// ---------------------------------------------------------------------------
// Admin-defined blackout windows (lunch, holidays, etc.)
// ---------------------------------------------------------------------------
model TimeBlockout {
  id            String   @id @default(cuid())
  startDatetime DateTime
  endDatetime   DateTime
  reason        String?
  createdAt     DateTime @default(now())

  @@map("time_blockouts")
}

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Customer & Member records (upserted by phone number)
// ---------------------------------------------------------------------------
model Customer {
  id                 String              @id @default(cuid())
  name               String
  phoneNumber        String              @unique
  isMember           Boolean             @default(false)
  creditBalanceCents Int                 @default(0)
  notes              String?
  memberSince        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  bookings           Booking[]
  memberPackages     MemberPackage[]
  memberTransactions MemberTransaction[]

  @@map("customers")
}

// ---------------------------------------------------------------------------
// Reusable Promo / Package templates (e.g. "RM288 for 10x Hair Cut")
// ---------------------------------------------------------------------------
model PromoPackage {
  id             String          @id @default(cuid())
  name           String
  description    String?
  priceCents     Int
  totalSessions  Int
  serviceIds     String[]        // Eligible Service IDs (multiple allowed)
  validityMonths Int?            // null = No expiry, otherwise valid for X months
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  memberPackages MemberPackage[]

  @@map("promo_packages")
}

// ---------------------------------------------------------------------------
// Member's purchased or bonus session packages
// ---------------------------------------------------------------------------
model MemberPackage {
  id                String              @id @default(cuid())
  customerId        String
  promoPackageId    String?
  name              String
  serviceIds        String[]
  totalSessions     Int
  remainingSessions Int
  pricePaidCents    Int                 @default(0)
  paymentMethod     String?             // "CASH" | "DUITNOW_QR" | "CARD" | "BONUS"
  expiresAt         DateTime?
  status            String              @default("ACTIVE") // "ACTIVE" | "COMPLETED" | "EXPIRED" | "CANCELLED"
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  promoPackage      PromoPackage?       @relation(fields: [promoPackageId], references: [id], onDelete: SetNull)
  transactions      MemberTransaction[]
  bookingItems      BookingItem[]

  @@index([customerId])
  @@map("member_packages")
}

// ---------------------------------------------------------------------------
// Member Credit & Promo Transaction Ledger (also tracks cash sales on reload/buy)
// ---------------------------------------------------------------------------
model MemberTransaction {
  id                String         @id @default(cuid())
  customerId        String
  memberPackageId   String?
  bookingId         String?
  idempotencyKey    String?        @unique
  type              String         // "CREDIT_RELOAD" | "CREDIT_DEDUCT" | "PACKAGE_PURCHASE" | "PACKAGE_DEDUCT" | "MANUAL_ADJUST"
  creditChangeCents Int            @default(0)
  balanceAfterCents Int            @default(0)
  sessionsChange    Int            @default(0)
  sessionsAfter     Int?
  cashPaidCents     Int            @default(0) // Counted in Today's Sales on the day paid
  paymentMethod     String?        // "CASH" | "DUITNOW_QR" | "CARD" | "CREDIT" | "PROMO"
  description       String
  createdAt         DateTime       @default(now())

  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  memberPackage     MemberPackage? @relation(fields: [memberPackageId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([createdAt])
  @@map("member_transactions")
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------
enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Booking {
  id                     String        @id @default(cuid())
  referenceCode          String        @unique
  checkoutIdempotencyKey String?       @unique
  customerId             String
  serviceId          String
  startDatetime      DateTime
  endDatetime        DateTime
  totalPriceCents    Int
  depositDueCents    Int?
  balanceDueCents    Int?
  creditUsedCents    Int           @default(0)
  promoDiscountCents Int           @default(0)
  status             BookingStatus @default(PENDING)
  notes              String?
  receiptSubmittedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  customer           Customer      @relation(fields: [customerId], references: [id])
  service            Service       @relation(fields: [serviceId], references: [id])
  items              BookingItem[]

  @@index([startDatetime])
  @@index([status])
  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Itemized services/products for a booking (supports multi-service + promo redeem)
// ---------------------------------------------------------------------------
model BookingItem {
  id                 String         @id @default(cuid())
  bookingId          String
  serviceId          String
  priceCents         Int
  originalPriceCents Int?
  memberPackageId    String?
  createdAt          DateTime       @default(now())

  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service            Service        @relation(fields: [serviceId], references: [id])
  memberPackage      MemberPackage? @relation(fields: [memberPackageId], references: [id], onDelete: SetNull)

  @@map("booking_items")
}

// ---------------------------------------------------------------------------
// Admin user (single-tenant — typically one row)
// ---------------------------------------------------------------------------
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  pinCode      String?  @default("1234")
  createdAt    DateTime @default(now())

  @@map("admin_users")
}

// ---------------------------------------------------------------------------
// Deposit & DuitNow QR settings (single-row configuration)
// ---------------------------------------------------------------------------
model DepositSetting {
  id             String   @id @default("default")
  isEnabled      Boolean  @default(false)
  type           String   @default("FIXED") // "FIXED" or "PERCENTAGE"
  amountCents    Int      @default(1000)   // e.g. 1000 = RM10.00
  percentage     Int      @default(20)     // e.g. 20 = 20%
  duitnowPayload String?  @db.Text
  qrImageUrl     String?  @db.Text // Exact uploaded TNG/DuitNow QR screenshot from merchant app
  recipientName  String?
  currency       String   @default("MYR")
  currencySymbol String   @default("RM")
  deskLanguage   String   @default("BILINGUAL_ZH_FIRST")
  showTodaySales        Boolean  @default(true)
  showYesterdaySales    Boolean  @default(true)
  showMonthlySales      Boolean  @default(true)
  showServiceBreakdown  Boolean  @default(true)
  showMakeAppointment   Boolean  @default(true)
  showWalkIn            Boolean  @default(true)
  showBookedCheckout    Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@map("deposit_settings")
}

// ---------------------------------------------------------------------------
// Deposit-exempt customers (regular/VIP customers who don't need to pay deposit)
// ---------------------------------------------------------------------------
model DepositExemptCustomer {
  id          String   @id @default(cuid())
  phoneNumber String   @unique // Normalized e.g. "0123456789"
  name        String?  // Optional name e.g. "Sarah Tan"
  note        String?  // Optional note e.g. "VIP regular since 2023"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phoneNumber])
  @@map("deposit_exempt_customers")
}

// ---------------------------------------------------------------------------
// Business expenses & stock purchases (for monthly P&L and net profit)
// ---------------------------------------------------------------------------
model Expense {
  id          String   @id @default(cuid())
  title       String
  category    String   @default("STOCK") // "STOCK" | "RENT" | "UTILITIES" | "SALARY" | "OTHER"
  amountCents Int
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@map("expenses")
}

