# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
NODE_ENV=development

# Application Mode:
# - "external" (default): Public online booking funnel at root (/)
# - "internal": In-house staff / salon desk mode only; root (/) redirects to /admin
NEXT_PUBLIC_APP_MODE="external"

# ─────────────────────────────────────────────────────────────
# Database — PostgreSQL connection string
# For local docker-compose dev:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookingdb"
# For Supabase (hosted PostgreSQL, no SDK):
#   DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookingdb"

# ─────────────────────────────────────────────────────────────
# JWT — change this to a secure random string in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────
JWT_SECRET="dev-secret-change-me-in-production"

# ─────────────────────────────────────────────────────────────
# Admin seeder password (used by prisma/seed.ts only)
# ─────────────────────────────────────────────────────────────
ADMIN_SEED_PASSWORD="admin123"

# ─────────────────────────────────────────────────────────────
# Public env vars (exposed to the browser)
# ─────────────────────────────────────────────────────────────

# Business display name
NEXT_PUBLIC_BUSINESS_NAME="Serenity Wellness Studio"

# Merchant WhatsApp number (international format, no +)
# e.g. Malaysian: 60123456789
NEXT_PUBLIC_MERCHANT_WHATSAPP="60123456789"

# Optional: URL to your DuitNow / Touch 'n Go QR code image
# Leave empty to show the placeholder
NEXT_PUBLIC_PAYMENT_QR_URL=""

# Custom Booking Reference Prefix (e.g. BK, SPA, CLINIC, SALON)
NEXT_PUBLIC_BOOKING_REF_PREFIX="BK"

# Operating Hours Configuration (used for off-duty notices & next-day confirmation advice)
# 24-hour format: 9 = 9:00 AM, 19 = 7:00 PM
NEXT_PUBLIC_OPERATING_HOUR_START="9"
NEXT_PUBLIC_OPERATING_HOUR_END="19"
# Closed days of week: comma-separated (0=Sun, 1=Mon, ..., 6=Sat). Leave empty if open daily.
NEXT_PUBLIC_CLOSED_DAYS="0"
NEXT_PUBLIC_OPERATING_DAYS_DESCRIPTION="Mon – Sat"
NEXT_PUBLIC_OPERATING_HOURS_DISPLAY="9:00 AM – 7:00 PM"

# Currency Configuration (Default fallback: "RM" for Malaysia, "$" for Australia)
NEXT_PUBLIC_CURRENCY_SYMBOL="RM"
NEXT_PUBLIC_CURRENCY_CODE="MYR"
NEXT_PUBLIC_BUSINESS_TIMEZONE="Asia/Kuala_Lumpur"

